<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reverse proxy IIS pour un hébergement ON-PREMISE d'e-depot sous
      https://ci-apps.medlog.com/e-depot
  - /e-depot/api/*  → API Node locale (NestJS) sur http://localhost:3001
  - /e-depot/*      → front (ici : Netlify ; remplacer par un service local si besoin)

  PRÉREQUIS IIS (une fois) : modules "URL Rewrite" + "Application Request Routing (ARR)",
  puis ARR → Server Proxy Settings → cocher "Enable proxy".

  ⚠️ L'ordre des règles est important : la règle API (plus spécifique) DOIT être avant
     la règle front, sinon les appels /api partiraient vers le front.

  Déposer ce fichier comme web.config à la racine du site ci-apps.medlog.com.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>

        <!-- 1) API : /e-depot/api/...  →  API Node locale -->
        <rule name="e-depot API -> Node local" stopProcessing="true">
          <match url="^e-depot/api(/.*)?$" />
          <action type="Rewrite" url="http://localhost:3001/api{R:1}" />
        </rule>

        <!-- 2) Front : le reste de /e-depot/...  →  Netlify
             (remplacer par un site/dossier local si le front est servi par IIS) -->
        <rule name="e-depot front -> Netlify" stopProcessing="true">
          <match url="^e-depot(/.*)?$" />
          <action type="Rewrite" url="https://e-depot.netlify.app/e-depot{R:1}" />
        </rule>

      </rules>
    </rewrite>

    <!-- Laisser passer les gros corps (import de la base conteneurs). -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
